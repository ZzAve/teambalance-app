{
  "name": "@teambalance/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx @tanstack/router-cli generate && tsc -b && vite build && node scripts/verify-pwa-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "e2e:www": "playwright test --config playwright.www.config.ts",
    "yolo": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --only-changed --externals \"design-tokens/*.css\" --untraced \"app/src/shared/i18n/locales/**\" --exit-zero-on-changes",
    "generate-pwa-assets": "pwa-assets-generator",
    "generate-pwa-screenshots": "node scripts/capture-pwa-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/grandstander": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.5.11",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "5.5.6",
    "react-i18next": "17.1.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.14"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "chromatic": "18.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "playwright": "1.62.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
